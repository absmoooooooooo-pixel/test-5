# Copy to backend/.env and adjust. Never commit the real .env.

# Server
PORT=8080
HOST=127.0.0.1
NODE_ENV=development

# Folder served as the website (relative to backend/, or absolute)
FRONTEND_DIR=../frontend

# Public URL of this API as seen by the browser.
# Empty = same origin, which is correct when this server also serves the site.
PUBLIC_API_BASE=

# Extra browser origins allowed to call the API (comma separated).
# Leave empty when the frontend is served from this same server.
ALLOWED_ORIGINS=

# Optional shared key. When set, POST /api/calculate requires x-api-key.
API_KEY=

# Rate limiting for /api (requests per window, per client IP)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Largest accepted JSON body, in bytes
MAX_BODY_BYTES=16384
